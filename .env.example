# Backend API Configuration
# Set this to your backend API base URL when connecting to a real backend
# Default: VITE_API_URL=http://localhost:8000
# Note: The health check endpoint (checkHealth) hits the root /health endpoint,
# while all other endpoints are prefixed with /api/v1. The API client handles
# this distinction internally.
# Leave empty to run in demo mode (no backend connection)
VITE_API_URL=http://localhost:8000
